{
  "name": "aasveer-aiml-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Aasveer Singh | AI/ML Engineer Portfolio: a static Next.js site built from versioned content and a build-time SQLite database.",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "db:build": "tsx scripts/build-db.ts",
    "dev": "tsx scripts/build-db.ts && cross-env PORTFOLIO_PREVIEW=1 next dev",
    "dev:release": "tsx scripts/build-db.ts && next dev",
    "dev:preview": "tsx scripts/build-db.ts && cross-env PORTFOLIO_PREVIEW=1 next dev",
    "build": "tsx scripts/build-db.ts && next build && tsx scripts/write-seo-files.ts && tsx scripts/verify-static.ts",
    "og:generate": "tsx scripts/generate-og-image.ts",
    "icons:generate": "tsx scripts/generate-icons.ts",
    "verify:static": "tsx scripts/verify-static.ts",
    "start": "tsx scripts/serve-out.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:links": "tsx scripts/check-links.ts",
    "lighthouse": "tsx scripts/lighthouse.ts",
    "release:check": "tsx scripts/release-check.ts",
    "test:e2e:preview": "playwright test --config playwright.preview.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "better-sqlite3": "^12.11.1",
    "clsx": "2.1.1",
    "geist": "1.8.2",
    "motion": "14.8.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.1.2",
    "cross-env": "^10.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.3",
    "lighthouse": "13.6.0",
    "postcss": "^8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
