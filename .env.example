# Public base URL of the deployed site, used for metadata (canonical URL, Open Graph).
# Not a secret. Leave unset for local development.
NEXT_PUBLIC_SITE_URL=

# Development-only: set to 1 to show clearly labelled fixture project cards in `next dev`.
# Ignored (and rejected) by production builds. Prefer `pnpm dev:preview` over setting this by hand.
# PORTFOLIO_PREVIEW=1

# Contact form: the URL the form posts to. Required for the form to send messages; without it the
# form says it is not connected and never reports a message as sent. Public by design (it is
# inlined into the static site at build time), so never put a secret here.
# The form POSTs JSON { name, email, message, _gotcha } with "Accept: application/json" and treats
# any 2xx response as delivered, unless the body is { "ok": false }. Formspree
# (https://formspree.io/f/<form-id>) works as is; `_gotcha` is its honeypot field, field errors in
# its 4xx answers are shown under the matching field, and 429 is reported as a rate limit.
# Must be an https URL. Put the real value in .env.local (git-ignored) or the host's build settings.
# Rebuild after changing it.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=

# Certifications layout: "orbit" (Credential Orbit, the default) or "classic" (the original
# credential archive). Optional; overrides CERTIFICATIONS_LAYOUT in src/config/layout.ts for one
# build, so the two can be compared without editing code. Rebuild after changing it.
# NEXT_PUBLIC_CERTIFICATIONS_LAYOUT=classic
